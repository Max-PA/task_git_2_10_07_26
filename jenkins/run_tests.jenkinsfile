pipeline {
    agent any
    environment {
            DATABASE_URL = credentials('docker-database-url')
        }
        
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Max-PA/task_git_2_10_07_26.git'
            }
        }
        stage('Cleanup and Install python') {
            steps {
                sh '''rm -rf allure-results
                        rm -rf allure-report
                        apt-get update
                        apt-get install -y python3 python3-dev
                        apt install -y python3-pip
                        apt install -y python3.13-venv
                        python3 -m venv venv'''
            }
        }
        stage('Install requirements') {
            steps {
                sh '''#!/bin/bash
                        source venv/bin/activate
                        pip install -r lesson_29/requirements.txt
                        '''
            }
        }
        stage('Run Tests') {
            steps {
                sh '''#!/bin/bash
                    venv/bin/python -m pytest lesson_29/tests --junitxml=junit-results.xml --alluredir=lesson_29/allures-results
                '''
            }
        }
    }
    post {
        always {
            allure commandline: 'Allure', includeProperties: false, jdk: '', resultPolicy: 'LEAVE_AS_IS', results: [[path: 'lesson_29/allures-results']]
            
            junit 'junit-results.xml'
        }
    }
}

// Poll SCM verification